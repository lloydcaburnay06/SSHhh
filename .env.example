# ==============================================================================
# SSHhh — Environment Configuration
# "Deployments so quiet, you can hear a server drop."
# Copy this file to `.env` and adjust values for your environment.
# ==============================================================================

# Application
DEPLOYER_APP_NAME="SSHhh"
DEPLOYER_APP_TAGLINE="Deployments so quiet, you can hear a server drop."
DEPLOYER_TIMEZONE=UTC

# Database (MySQL / MariaDB)
DEPLOYER_DB_HOST=127.0.0.1
DEPLOYER_DB_PORT=3306
DEPLOYER_DB_NAME=ssh_deployer
DEPLOYER_DB_USER=root
DEPLOYER_DB_PASS=

# Access Control & Security
# - By default, when DEPLOYER_APP_PASSWORD is empty, access is restricted to
#   localhost (127.0.0.1 / ::1) only.
# - Set DEPLOYER_APP_PASSWORD (or a password_hash() value in DEPLOYER_APP_PASSWORD_HASH)
#   to require login authentication and safely allow remote access.
DEPLOYER_APP_PASSWORD=
DEPLOYER_APP_PASSWORD_HASH=
DEPLOYER_ALLOW_REMOTE=false

# Optional 256-bit Encryption Master Key Override (min 32 chars / 64 hex chars).
# Leave blank to auto-generate and use `storage/secret.key`.
DEPLOYER_SECRET_KEY=
