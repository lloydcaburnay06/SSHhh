# ==============================================================================
# SSHhh — "Deployments so quiet, you can hear a server drop."
# Copy to `.env`, then run: php artisan key:generate && php artisan migrate
# ==============================================================================

APP_NAME="SSHhh"
APP_TAGLINE="Deployments so quiet, you can hear a server drop."
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# Where SSHhh is served from (XAMPP: http://localhost/deployer)
APP_URL=http://localhost/deployer
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Database (MySQL / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ssh_deployer
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=720
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Access control: sign-in is Google Authenticator (TOTP), configured on first visit.
# The first-time setup screen only works from this computer (localhost).

# Optional 256-bit vault master key (min 32 chars / 64 hex chars).
# Blank = auto-generate and use storage/secret.key. Never change it after
# credentials are stored, or they can no longer be decrypted.
DEPLOYER_SECRET_KEY=

VITE_APP_NAME="${APP_NAME}"
